# Keep line endings stable across Windows, macOS and Linux checkouts.
#
# The shell scripts and the systemd units run on Linux: a CRLF checkout would
# break them with "bad interpreter" or "unexpected token". Git for Windows is
# configured with core.autocrlf=true by default, so without this file a clone
# on the developer machine would corrupt everything that runs on the server.
* text=auto eol=lf

*.sh        text eol=lf
Makefile    text eol=lf
Dockerfile  text eol=lf
*.service   text eol=lf

# Binary assets must never be converted or diffed as text.
*.png   binary
*.ico   binary
*.exe   binary
*.dll   binary
*.zip   binary
*.syso  binary
