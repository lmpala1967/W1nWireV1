# EditorConfig — https://editorconfig.org
# Helps every contributor keep a consistent style across editors and IDEs.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# ---------------------------------------------------------------------------
# Go — gofmt uses tabs for indentation and spaces for alignment.
# ---------------------------------------------------------------------------
[*.go]
indent_style = tab
indent_size = 4
trim_trailing_whitespace = false

[go.mod]
indent_style = tab

[go.sum]
trim_trailing_whitespace = false

# ---------------------------------------------------------------------------
# YAML / JSON — 2 spaces (matches the CI and compose files).
# ---------------------------------------------------------------------------
[*.{yml,yaml}]
indent_style = space
indent_size = 2

[*.{json,jsonc}]
indent_style = space
indent_size = 2

[Makefile]
indent_style = tab

[*.mk]
indent_style = tab

# ---------------------------------------------------------------------------
# Shell scripts — 2 spaces, LF endings.
# ---------------------------------------------------------------------------
[*.sh]
indent_style = space
indent_size = 2

# ---------------------------------------------------------------------------
# Documentation & web assets.
# ---------------------------------------------------------------------------
[*.md]
indent_style = space
indent_size = 2
trim_trailing_whitespace = false

[*.{html,css,scss,js,ts,tsx}]
indent_style = space
indent_size = 2

# ---------------------------------------------------------------------------
# Terraform / HCL.
# ---------------------------------------------------------------------------
[*.tf]
indent_style = space
indent_size = 2

[*.tfvars]
indent_style = space
indent_size = 2

# ---------------------------------------------------------------------------
# Never trim trailing whitespace in these (Markdown hard line breaks).
# ---------------------------------------------------------------------------
[*.{md,markdown}]
trim_trailing_whitespace = false
